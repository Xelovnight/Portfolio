---
import { getCollection, render } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechCarousel from '../../components/TechCarousel.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 1. GESTION DES PROJETS
const allProjects = await getCollection('projets');
const enProjects = allProjects.filter(project => project.id.startsWith('en/') || project.id.startsWith('en\\'));
const sortedProjects = enProjects.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
const latestProjects = sortedProjects.slice(0, 3);

const processedProjects = await Promise.all(
  latestProjects.map(async (project) => {
    const { Content } = await render(project);
    return { ...project, Content };
  })
);

// 2. NOUVEAU : GESTION DES EXPÉRIENCES
const allExperiences = await getCollection('experiences');
const enExperiences = allExperiences.filter(exp => exp.id.startsWith('en/') || exp.id.startsWith('en\\'));
// Tri de la plus récente à la plus ancienne
const sortedExperiences = enExperiences.sort((a, b) => new Date(b.data.startDate).valueOf() - new Date(a.data.startDate).valueOf());
// On ne garde que les 3 dernières !
const latestExperiences = sortedExperiences.slice(0, 3);

const processedExperiences = await Promise.all(
  latestExperiences.map(async (exp) => {
    const { Content } = await render(exp);
    return { ...exp, Content };
  })
);

// Fonction pour formater les dates proprement
const formatDate = (date: Date) => {
  return date.toLocaleDateString(lang, { month: 'long', year: 'numeric' });
};

// 3. GESTION DES CERTIFICATIONS
const allCerts = await getCollection('certifications');
const enCerts = allCerts.filter(cert => cert.id.startsWith('en/') || cert.id.startsWith('en\\'));
// Tri de la plus récente à la plus ancienne
const sortedCerts = enCerts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
// On ne garde que les 3 dernières
const latestCerts = sortedCerts.slice(0, 3);

const processedCerts = await Promise.all(
  latestCerts.map(async (cert) => {
    const { Content } = await render(cert);
    return { ...cert, Content };
  })
);

---

<BaseLayout title={`${t('home.title')} | Portfolio`}>
  
  <main class="max-w-6xl mx-auto p-8 pt-16">
    
    <header class="mb-20 text-center">
      <!-- Un dégradé plus "Rocket" (Bleu vers Violet) et plus saturé -->
      <h1 
        class="text-5xl md:text-6xl font-extrabold mb-6 pb-2 bg-clip-text text-transparent tracking-tight leading-[1.15]"
        style="background-image: linear-gradient(to bottom right, var(--gradient-start), var(--accent));"
      >
        {t('home.title')}
      </h1> 
      <p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        {t('home.subtitle')}
      </p>
    </header>

    <TechCarousel />

    <!-- SECTION : DERNIERS PROJETS -->
    <section class="mb-24">
      <h2 class="text-2xl font-bold mb-8 text-zinc-900 dark:text-zinc-100 flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        {t('home.latestProjects')}
      </h2>
      
      <!-- 1. LA GRILLE DES CARTES -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {processedProjects.map((project) => (
          <article class="border border-zinc-200/80 dark:border-zinc-800/80 rounded-3xl p-7 shadow-sm bg-zinc-50/50 dark:bg-zinc-900/30 backdrop-blur-sm flex flex-col justify-between hover:border-accent transition-all duration-300 group">
            <div>
              <div class="flex items-center gap-3 mb-5">
                <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center font-bold text-accent">
                  {project.data.tags[0]?.[0]}
                </div>
                <div>
                  <h3 class="text-2xl font-semibold group-hover:text-accent transition-colors">{project.data.title}</h3>
                  <time class="text-sm text-zinc-500 capitalize">
                    {project.data.date.toLocaleDateString(lang, { month: 'long', year: 'numeric' })}
                  </time>
                </div>
              </div>
              <p class="text-zinc-600 dark:text-zinc-300 mb-6 line-clamp-3 leading-relaxed">
                {project.data.description}
              </p>
              <div class="flex flex-wrap gap-2.5 mb-8">
                {project.data.tags.map((tag: string) => (
                  <span class="bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 text-xs font-semibold px-3 py-1 rounded-full border border-zinc-200/50 dark:border-zinc-700/50">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            
            <button class="w-full text-center bg-accent text-white font-semibold py-3 px-6 rounded-2xl hover:opacity-90 transition duration-200 shadow-sm open-modal-btn" data-project-id={project.id}>
              {t('home.discover')}
            </button>
          </article>
        ))}
      </div>

      <!-- 2. LES MODALES (Séparées et libres de prendre tout l'écran) -->
      {processedProjects.map((project) => (
        <div id={`modal-${project.id}`} class="fixed inset-0 z-[60] hidden items-center justify-center p-4 sm:p-6">
          <!-- Backdrop flouté -->
          <div class="absolute inset-0 bg-black/60 dark:bg-black/80 backdrop-blur-sm close-modal-backdrop" data-project-id={project.id}></div>
          
          <!-- Contenu de la Modale -->
          <div class="animated-modal relative z-[70] p-0 rounded-3xl w-full max-w-4xl max-h-[90vh] overflow-hidden bg-white dark:bg-zinc-900 shadow-2xl transition-all duration-300">
            <div class="p-8 md:p-12 overflow-y-auto max-h-[90vh]">
              <div class="flex items-start justify-between mb-10 gap-6">
                <div>
                  <h2 class="text-4xl font-bold mb-3">{project.data.title}</h2>
                  <p class="text-sm text-zinc-500 capitalize">
                    {t('home.madeIn')} {project.data.date.toLocaleDateString(lang, { month: 'long', year: 'numeric' })}
                  </p>
                </div>
                <button class="close-modal-btn text-zinc-500 hover:text-red-500 bg-zinc-100 dark:bg-zinc-800 rounded-full w-10 h-10 flex items-center justify-center transition-colors relative z-[80]" data-project-id={project.id}>
                  <span class="text-2xl">&times;</span>
                </button>
              </div>
              <article class="prose prose-lg dark:prose-invert max-w-none text-zinc-700 dark:text-zinc-300 leading-relaxed">
                <project.Content />
              </article>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- NOUVELLE SECTION : DERNIÈRES EXPÉRIENCES -->
    <section>
      <div class="flex justify-between items-end mb-10 border-b-2 pb-3 border-gray-100 dark:border-gray-800">
        <h2 class="text-2xl font-bold mb-8 text-zinc-900 dark:text-zinc-100 flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        {t('home.latestExperiences')}
      </h2>
        <!-- Lien vers la page complète des expériences -->
        <a href={`${import.meta.env.BASE_URL}en/experiences`} class="text-accent hover:underline text-sm font-semibold hidden md:inline-block">
          <Fragment set:html={t('home.allExperiences')} />
        </a>
      </div>
      
      <div class="relative border-l border-gray-200 dark:border-gray-800 ml-4 md:ml-0 max-w-4xl">
        {processedExperiences.map((exp) => (
          <div class="mb-10 ml-10 relative">
            <span class="absolute flex items-center justify-center w-6 h-6 bg-accent/10 rounded-full -left-[52px] ring-8 ring-white dark:ring-gray-950">
              <div class="w-2.5 h-2.5 bg-accent rounded-full"></div>
            </span>
            
            <article class="p-6 bg-gray-50/50 dark:bg-gray-900/30 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm transition-colors hover:border-accent dark:hover:border-accent">
              <div class="flex flex-col md:flex-row md:items-center justify-between mb-2">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">{exp.data.role}</h3>
                <div class="text-xs font-medium text-accent bg-accent/10 px-3 py-1 rounded-full w-fit mt-2 md:mt-0 capitalize">
                  {formatDate(exp.data.startDate)} - {exp.data.endDate ? formatDate(exp.data.endDate) : t('experiences.present')}
                </div>
              </div>
              <h4 class="text-md font-medium text-gray-600 dark:text-gray-400 mb-3">{exp.data.company}</h4>
              
              <div class="prose prose-sm dark:prose-invert max-w-none text-gray-700 dark:text-gray-300 mb-4 line-clamp-2">
                <exp.Content />
              </div>
              
              <div class="flex flex-wrap gap-2">
                {exp.data.skills.slice(0, 4).map((skill: string) => (
                  <span class="bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-xs font-semibold px-2.5 py-0.5 rounded-md border border-gray-200 dark:border-gray-700">
                    {skill}
                  </span>
                ))}
                {exp.data.skills.length > 4 && (
                  <span class="text-xs text-gray-500 py-0.5 px-1">+{exp.data.skills.length - 4}</span>
                )}
              </div>
            </article>
          </div>
        ))}
      </div>

      <!-- Lien visible sur mobile -->
      <div class="mt-6 text-center md:hidden">
        <a href={`${import.meta.env.BASE_URL}en/experiences`} class="text-accent hover:underline text-sm font-semibold">
          <Fragment set:html={t('home.allExperiences')} />
        </a>
      </div>
    </section>

    <!-- NOUVELLE SECTION : DERNIÈRES CERTIFICATIONS -->
    <section class="mt-24">
      <div class="flex justify-between items-end mb-10 border-b-2 pb-3 border-gray-100 dark:border-gray-800">
        <h2 class="text-2xl font-bold mb-8 text-zinc-900 dark:text-zinc-100 flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          {t('home.latestCertifications')}
        </h2>
        <!-- Lien vers la page complète -->
        <a href={`${import.meta.env.BASE_URL}certifications`} class="text-accent hover:underline text-sm font-semibold hidden md:inline-block">
          <Fragment set:html={t('home.allCertifications')} />
        </a>
      </div>

      <!-- Grille de 3 colonnes -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {processedCerts.map((cert) => (
          <article class="p-6 bg-gray-50/50 dark:bg-gray-900/30 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm flex flex-col justify-between hover:border-accent dark:hover:border-accent transition-colors">
            <div>
              <div class="flex items-start justify-between mb-4">
                <div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-1">{cert.data.title}</h3>
                  <p class="text-accent text-sm font-medium">{cert.data.issuer}</p>
                </div>
                <div class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center text-lg shrink-0">
                  🏆
                </div>
              </div>

              <time class="text-xs text-gray-500 dark:text-gray-400 block mb-4 capitalize">
                {t('home.madeIn').replace('Projet réalisé en', 'Obtenue en').replace('Project made in', 'Earned in')} {cert.data.date.toLocaleDateString(lang, { month: 'long', year: 'numeric' })}
              </time>
              
              <div class="prose prose-sm dark:prose-invert text-gray-600 dark:text-gray-300 mb-6 line-clamp-3">
                <cert.Content />
              </div>
            </div>

            {cert.data.link && (
              <a href={cert.data.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-sm font-semibold text-gray-900 dark:text-white hover:text-accent transition-colors mt-auto pt-4 border-t border-gray-100 dark:border-gray-800">
                {t('certifications.verify')} <span class="ml-1">&nearr;</span>
              </a>
            )}
          </article>
        ))}
      </div>

      <!-- Lien visible uniquement sur mobile -->
      <div class="mt-6 text-center md:hidden">
        <a href={`${import.meta.env.BASE_URL}certifications`} class="text-accent hover:underline text-sm font-semibold">
          <Fragment set:html={t('home.allCertifications')} />
        </a>
      </div>
    </section>
  </main>

<!-- Nouveau Script des Modales -->
  <script>
    const openButtons = document.querySelectorAll('.open-modal-btn');
    const closeButtons = document.querySelectorAll('.close-modal-btn');
    const backdrops = document.querySelectorAll('.close-modal-backdrop');

    // Ouvrir
    openButtons.forEach(button => {
      button.addEventListener('click', () => {
        const projectId = button.getAttribute('data-project-id');
        const modal = document.getElementById(`modal-${projectId}`);
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden'; // Empêche de scroller la page en fond
        }
      });
    });

    // Fonction de fermeture
    const closeModal = (projectId) => {
      const modal = document.getElementById(`modal-${projectId}`);
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = ''; // Réactive le scroll
      }
    };

    // Fermer via le bouton X
    closeButtons.forEach(button => {
      button.addEventListener('click', () => {
        closeModal(button.getAttribute('data-project-id'));
      });
    });

    // Fermer en cliquant à côté de la modale (sur le fond flou)
    backdrops.forEach(backdrop => {
      backdrop.addEventListener('click', () => {
        closeModal(backdrop.getAttribute('data-project-id'));
      });
    });
  </script>

</BaseLayout>