---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`${t('contact.title')} | Portfolio`}>
  <main class="max-w-5xl mx-auto p-8 pt-16 mb-20">
    
    <header class="mb-16 text-center">
      <h1 class="text-5xl font-extrabold mb-4 bg-gradient-to-r from-blue-600 to-sky-400 bg-clip-text text-transparent">
        {t('contact.title')}
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 max-w-xl mx-auto">
        {t('contact.subtitle')}
      </p>
    </header>

    <div class="flex flex-col lg:flex-row gap-12 bg-gray-50/50 dark:bg-gray-900/30 p-8 md:p-12 rounded-3xl border border-gray-100 dark:border-gray-800 shadow-sm">
      
      <!-- Colonne de gauche : Infos directes -->
      <div class="w-full lg:w-1/3 flex flex-col gap-8">
        <div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Email</h3>
          <a href="mailto:ton.email@exemple.com" class="text-accent hover:underline">
            ton.email@exemple.com
          </a>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{t('contact.location')}</h3>
          <p class="text-gray-600 dark:text-gray-400">{t('contact.locationText')}</p>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">{t('contact.socials')}</h3>
          <div class="flex gap-4">
            <a href="https://linkedin.com/in/ton-profil" target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-white dark:bg-gray-800 rounded-full flex items-center justify-center text-gray-700 dark:text-gray-300 hover:text-accent hover:shadow-md transition-all border border-gray-200 dark:border-gray-700">
              <span class="sr-only">LinkedIn</span>
              <!-- Icône LinkedIn -->
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://github.com/ton-pseudo" target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-white dark:bg-gray-800 rounded-full flex items-center justify-center text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:shadow-md transition-all border border-gray-200 dark:border-gray-700">
              <span class="sr-only">GitHub</span>
              <!-- Icône GitHub -->
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Colonne de droite : Formulaire -->
      <div class="w-full lg:w-2/3">
        <form action="https://formspree.io/f/TON_ID_FORMSPREE" method="POST" class="flex flex-col gap-6">
          
          <div class="flex flex-col md:flex-row gap-6">
            <div class="w-full">
              <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{t('contact.name')}</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--accent)] focus:border-[var(--accent)] outline-none transition-all" />
            </div>
            <div class="w-full">
              <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{t('contact.email')}</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--accent)] focus:border-[var(--accent)] outline-none transition-all" />
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{t('contact.message')}</label>
            <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--accent)] focus:border-[var(--accent)] outline-none transition-all resize-y"></textarea>
          </div>

          <button type="submit" class="self-end bg-accent text-white font-semibold py-3 px-8 rounded-xl hover:bg-accent/90 dark:hover:bg-accent/80 transition shadow-sm w-full md:w-auto">
            {t('contact.send')}
          </button>
          
        </form>
      </div>

    </div>
  </main>
</BaseLayout>