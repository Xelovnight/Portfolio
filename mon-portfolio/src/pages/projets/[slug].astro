---
import { getCollection, render } from 'astro:content';

// 1. Cette fonction dit à Astro quelles pages générer lors du build
export async function getStaticPaths() {
  const projets = await getCollection('projets');
  
  return projets.map(projet => ({
    params: { slug: projet.id }, // L'URL de la page (ex: /projets/mon-projet)
    props: { projet },           // Les données passées à la page
  }));
}

// 2. On récupère les propriétés du projet courant
const { projet } = Astro.props;

// 3. On demande à Astro de préparer le contenu Markdown pour l'affichage
const { Content } = await render(projet);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{projet.data.title} | Enzo Jungers</title>
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100 transition-colors duration-300">
    <main class="max-w-3xl mx-auto p-8">
      
      <!-- Bouton retour -->
      <a href="/" class="text-accent hover:underline mb-8 inline-block">
        &larr; Retour à l'accueil
      </a>

      <!-- En-tête du projet -->
      <header class="mb-10">
        <h1 class="text-4xl font-bold mb-4">{projet.data.title}</h1>
        
        <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400 mb-6">
          <time>{projet.data.date.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' })}</time>
        </div>

        <div class="flex flex-wrap gap-2">
          {projet.data.tags.map((tag: string) => (
            <span class="bg-gray-200 dark:bg-gray-700 px-3 py-1 rounded-full text-sm font-medium">
              {tag}
            </span>
          ))}
        </div>
      </header>

      <!-- Le contenu du fichier Markdown s'injecte ici -->
      <article class="prose prose-lg dark:prose-invert max-w-none">
        <Content />
      </article>

    </main>
  </body>
</html>