---
// La liste de tes technologies basée sur tes expériences (PRO BTP, DIRISI, Projets)
// Les logos sont chargés via Devicon et SimpleIcons pour garder le code propre.
const techs = [
  // Front-end & UI
  { name: "React.js", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg" },
  { name: "Angular", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/angular/angular-original.svg" },
  { name: "Astro", img: "https://cdn.simpleicons.org/astro/FF7E33" },
  { name: "Tailwind CSS", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg" },
  
  // Back-end & Langages
  { name: "Node.js", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg" },
  { name: "Java", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg" },
  { name: "Spring Boot", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/spring/spring-original.svg" },
  { name: "Python", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg" },
  { name: "PHP", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/php/php-original.svg" },
  { name: "C#", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/csharp/csharp-original.svg" },
  
  // Data & Base de données
  { name: "MySQL", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg" },
  { name: "Power BI", img: "https://cdn.simpleicons.org/powerbi/F2C811" },
  
  // DevOps & Outils (PRO BTP & DIRISI)
  { name: "Docker", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg" },
  { name: "GitLab", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/gitlab/gitlab-original.svg" },
  { name: "Jenkins", img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/jenkins/jenkins-original.svg" },
  { name: "ServiceNow", img: "https://cdn.simpleicons.org/servicenow/81B5A1" }
];

// L'astuce magique : on double le tableau pour que la boucle soit infinie sans "saut"
const duplicatedTechs = [...techs, ...techs];
---

<div class="w-full overflow-hidden mask-edges py-8 mb-16">
  <!-- Le conteneur qui défile -->
  <div class="flex w-max animate-scroll gap-6">
    
    {duplicatedTechs.map((tech) => (
      <div class="flex items-center gap-3 px-2 py-2 pr-5 bg-white/50 dark:bg-zinc-900/30 rounded-full border border-zinc-200 dark:border-zinc-800/80 backdrop-blur-sm transition-colors hover:border-accent/50 dark:hover:border-accent/50 cursor-default">
        <!-- Le cercle sombre avec l'icône -->
        <div class="w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-950 flex items-center justify-center shadow-inner border border-zinc-200 dark:border-zinc-800 p-2 relative overflow-hidden">
          <img 
            src={tech.img} 
            alt={`Logo de ${tech.name}`} 
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </div>
        <!-- Le texte -->
        <span class="font-medium text-sm text-zinc-700 dark:text-zinc-300">
          {tech.name}
        </span>
      </div>
    ))}
    
  </div>
</div>