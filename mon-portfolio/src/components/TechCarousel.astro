---
// La liste de tes technologies. 
// J'ai mis des emojis pour l'instant, mais tu pourras les remplacer par de vrais SVG (ex: depuis simpleicons.org)
const techs = [
  { name: "React.js", icon: "⚛️" },
  { name: "Node.js", icon: "🟩" },
  { name: "Angular", icon: "🅰️" },
  { name: "Java", icon: "☕" },
  { name: "Python", icon: "🐍" },
  { name: "Power BI", icon: "📊" },
  { name: "SQL", icon: "🗄️" },
  { name: "Tailwind CSS", icon: "🌊" },
  { name: "Docker", icon: "🐳" },
  { name: "Git", icon: "🔧" },
  { name: "Linux", icon: "🐧" },
  { name: "TypeScript", icon: "🟦" },
  { name: "JavaScript", icon: "🟨" },
  { name: "HTML5", icon: "📄" },
  { name: "CSS3", icon: "🎨" },
  { name: "C#", icon: "💠" },
  { name: "PHP", icon: "🐘" },
  { name: "MongoDB", icon: "🍃" },
  { name: "PostgreSQL", icon: "🐘" },
  { name: "MySQL", icon: "🐬" },
  { name: "REST API", icon: "🌐" }

];

// L'astuce magique : on double le tableau pour que la boucle soit infinie sans "saut"
const duplicatedTechs = [...techs, ...techs];
---

<div class="w-full overflow-hidden mask-edges py-8 mb-16">
  <!-- Le conteneur qui défile -->
  <div class="flex w-max animate-scroll gap-6">
    
    {duplicatedTechs.map((tech) => (
      <div class="flex items-center gap-3 px-2 py-2 pr-5 bg-white/50 dark:bg-zinc-900/30 rounded-full border border-zinc-200 dark:border-zinc-800/80 backdrop-blur-sm transition-colors hover:border-blue-500/50 dark:hover:border-blue-500/50 cursor-default">
        <!-- Le cercle sombre avec l'icône (comme sur ton image de référence) -->
        <div class="w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-950 flex items-center justify-center text-xl shadow-inner border border-zinc-200 dark:border-zinc-800">
          {tech.icon}
        </div>
        <!-- Le texte -->
        <span class="font-medium text-sm text-zinc-700 dark:text-zinc-300">
          {tech.name}
        </span>
      </div>
    ))}
    
  </div>
</div>