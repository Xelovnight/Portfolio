---
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';

// On récupère la langue actuelle
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

// On isole le nom de la page courante (sans le BASE_URL et sans la langue)
const baseUrl = import.meta.env.BASE_URL;
let route = Astro.url.pathname.replace(baseUrl, '/').replace('//', '/');

if (route.startsWith(`/${lang}/`)) {
  route = route.replace(`/${lang}/`, '/');
} else if (route === `/${lang}`) {
  route = '/';
}

// On génère les liens propres pour les drapeaux/boutons
const frUrl = translatePath(route, 'fr');
const enUrl = translatePath(route, 'en');
---

<!-- Ton design de bouton de langue (à adapter selon ton CSS) -->
<div class="flex items-center gap-3">
  <a href={frUrl} class={`hover:text-accent transition-colors ${lang === 'fr' ? 'font-bold text-accent' : ''}`}>FR</a>
  <span class="text-zinc-400">|</span>
  <a href={enUrl} class={`hover:text-accent transition-colors ${lang === 'en' ? 'font-bold text-accent' : ''}`}>EN</a>
</div>