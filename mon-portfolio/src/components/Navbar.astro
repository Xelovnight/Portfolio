---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import ThemeColorPicker from './ThemeColorPicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getPath = (path: string) => {
  if (path === '/') return lang === 'fr' ? '/' : '/en/';
  return lang === 'fr' ? path : `/en${path}`;
};

let currentPath = Astro.url.pathname.replace(/^\/en/, '');
if (currentPath.length > 1 && currentPath.endsWith('/')) {
  currentPath = currentPath.slice(0, -1);
}
if (currentPath === '') currentPath = '/';

const allLinks = [
  { url: '/', label: t('nav.home') },
  { url: '/projets', label: t('nav.projects') },
  { url: '/certifications', label: t('nav.certifications') },
  { url: '/experiences', label: t('nav.experiences') },
  { url: '/a-propos', label: t('nav.about') },
  { url: '/contact', label: t('nav.contact') }
];

const visibleLinks = allLinks.filter(link => link.url !== currentPath);
---

<header class="sticky top-6 z-40 w-full px-4 mb-12">
  <!-- ON A RETIRÉ overflow-hidden d'ici pour laisser le menu des couleurs s'ouvrir librement -->
  <nav class="max-w-4xl mx-auto backdrop-blur-xl bg-white/80 dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 rounded-2xl shadow-xl shadow-zinc-900/5 relative">
    
    <!-- La barre de progression garde son propre conteneur overflow-hidden pour épouser les coins arrondis du haut -->
    <div class="absolute top-0 left-0 right-0 h-[3px] rounded-t-2xl overflow-hidden z-50 pointer-events-none">
      <div 
        id="scroll-progress" 
        style="width: 0%;" 
        class="h-full bg-accent backdrop-blur-sm transition-all duration-75"
      ></div>
    </div>

    <div class="px-6 md:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Logo -->
        <a href={getPath('/')} class="font-bold text-xl tracking-tighter text-zinc-900 dark:text-zinc-100 hover:opacity-80 transition-opacity">
          EJ.
        </a>
        
        <!-- Liens de navigation dynamiques -->
        <ul class="hidden md:flex items-center space-x-8 text-sm font-medium text-zinc-600 dark:text-zinc-400">
          {visibleLinks.map((link) => (
            <li>
              <a href={getPath(link.url)} class="hover:text-zinc-900 dark:hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <!-- SECTION DROITE : Boutons côte à côte grâce à flex items-center gap-2 -->
        <div class="flex items-center gap-2">
          
          <!-- Version Desktop -->
          <div class="hidden md:flex items-center gap-2">
            <ThemeColorPicker />
            <ThemeToggle />
          </div>

          <!-- Version Mobile -->
          <div class="flex md:hidden items-center gap-2">
            <ThemeColorPicker />
            <ThemeToggle />
            <button class="text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white focus:outline-none p-2">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>

        </div>

      </div>
    </div>
  </nav>
</header>

<script>
  window.addEventListener('scroll', () => {
    const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
    
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) {
      progressBar.style.width = `${scrolled}%`;
    }
  });
</script>